 # Docker Compose reads `.env` here for variable substitution into services.
 # Do not commit the real `.env` file.
 
+# Core secrets (REQUIRED — docker-compose will refuse to start without these)
+# MySQL root password, shared by the `db` and `ai-service` containers.
+# Generate with: openssl rand -base64 24
+DB_PASSWORD=
+
+# Secret used to sign/verify JWTs. Anyone with this value can forge valid login tokens.
+# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
+JWT_SECRET=
+
+# Redis password. Optional for local-only dev, but REQUIRED if port 6379 is reachable
+# from outside your own machine (it is mapped to the host by default in docker-compose.yml).
+# Generate with: openssl rand -base64 24
+REDIS_PASSWORD=
+
 # M-Pesa / Safaricom Daraja (injected into `isp-backend` by docker-compose.yml)
 MPESA_CONSUMER_KEY=your_consumer_key
 MPESA_CONSUMER_SECRET=your_consumer_secret
