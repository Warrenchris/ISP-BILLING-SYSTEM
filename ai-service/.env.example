# ── AI Microservice Environment Variables ──────────────────────────────────
# Copy this file to .env in the ai-service directory and fill in your values.
# Do NOT commit the real .env file.

# Flask Microservice Configuration
PORT=5001
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# MySQL Database Configuration (must match the main backend DB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=isp_billing_db

# Groq LLM Configuration — get an API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
