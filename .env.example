# Copy this file to `.env` in this same directory (repository root).
# Docker Compose reads `.env` here for variable substitution into services.
# Do not commit the real `.env` file.

# M-Pesa / Safaricom Daraja (injected into `isp-backend` by docker-compose.yml)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback
MPESA_ENV=sandbox

# Optional aliases (MpesaService also reads these if set)
# MPESA_BUSINESS_SHORT_CODE=your_shortcode
# MPESA_PASS_KEY=your_passkey

# Phase 1: Router Provisioning & BullMQ
# Redis (required for BullMQ job queues)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Router credential encryption key (32-byte hex, REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Back this up — if lost, all stored router passwords become unreadable
ROUTER_ENCRYPTION_KEY=

# Set to 'true' for CI/local dev without a physical MikroTik router
MOCK_MIKROTIK=false

# Cron schedules
EXPIRY_CHECK_CRON=*/10 * * * *
RECONCILIATION_CRON=*/30 * * * *

# Grace period before auto-cutoff (hours, 0 = immediate)
DEFAULT_GRACE_PERIOD_HOURS=24

# Max provisioning retry attempts before permanent failure
PROVISIONING_MAX_RETRIES=10

# Delay (ms) before retrying a job when router circuit breaker is open
CIRCUIT_BREAKER_REQUEUE_DELAY_MS=60000
